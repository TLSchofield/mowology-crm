#!/usr/bin/env bash
# sentinel accept|reject|modify <id> "reason" [--note "..."]   |   sentinel list [--status X]   |   sentinel backlog   |   sentinel run daily|weekly
HERE="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
if [ "${1:-}" = "run" ]; then shift; exec bash "$HERE/run-audit.sh" "$@"; fi
case "${1:-}" in accept|reject|modify) exec python3 "$HERE/sentinel.py" decide "$2" "$1" "${@:3}";; esac
exec python3 "$HERE/sentinel.py" "$@"
