# Disable directory browsing
Options -Indexes

# Serve dashboard_appstack.php as default for /crm/ directory
DirectoryIndex dashboard_appstack.php index.php

# Protect sensitive files
<FilesMatch "^(config\.php|auth\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Force HTTPS (if you want to enforce it)
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]