# /public/api/.htaccess — Route clean API URLs to facade dispatcher
#
# Rewrites:  /api/jobs/create  →  /api/index.php?module=jobs&action=create
#             /api/team/time-clock  →  /api/index.php?module=team&action=time-clock
#
# Legacy URLs (/crm/api/*.php) still work via their shim files.

RewriteEngine On

# Pass Authorization header to PHP — Apache strips it by default on cPanel/mod_php.
# Required for JWT Bearer token authentication on mobile API endpoints.
RewriteCond %{HTTP:Authorization} .+
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# If the request maps to a real file, serve it directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Route /api/<module>/<action> to the facade dispatcher
RewriteRule ^([a-z]+)/([a-z0-9\-]+)/?$ index.php?module=$1&action=$2 [L,QSA]
