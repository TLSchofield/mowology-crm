# Composer packages: loaded with require from PHP on the server, never over HTTP.
# Fable review 2026-10-12 (Ada): the old rule granted HTTP access to every vendor .php file,
# so library scripts (examples, tests, CLI helpers) could be run from a browser. Deny all —
# PHP's require reads the filesystem and is unaffected.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
