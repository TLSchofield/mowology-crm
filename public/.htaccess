# Disable directory browsing
Options -Indexes

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
        application/javascript application/json application/xml \
        image/svg+xml font/woff2
</IfModule>

# ── Browser Caching ───────────────────────────────────────────────────────────
# mod_expires: used if available (some shared hosts don't enable it)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript        "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 30 days"
    ExpiresByType image/png              "access plus 30 days"
    ExpiresByType image/webp             "access plus 30 days"
    ExpiresByType image/gif              "access plus 30 days"
    ExpiresByType image/svg+xml          "access plus 30 days"
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType application/font-woff  "access plus 1 year"
    ExpiresByType application/json       "access plus 0 seconds"
    ExpiresByType text/html              "access plus 0 seconds"
</IfModule>
# mod_headers fallback: explicit Cache-Control on static file types
# CSS/JS have ?v= version params so 1-year cache is safe
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ── Security Headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Control referrer info sent to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable browser features not needed by this app
    # camera=(self): required for before/after job-photo capture in the Capacitor
    # WebView. camera=() blocks the camera at the web layer even when the OS
    # permission is granted, surfacing as "Access denied" on photo capture.
    Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=()"

    # Content Security Policy
    # - default: self only
    # - scripts: self + Google Maps + Stripe + AppStack inline (unsafe-inline kept for AppStack vendor JS)
    # - styles: self + Google Fonts + unsafe-inline (AppStack uses inline styles)
    # - frames: 'self' allows same-origin iframes (e.g. /crm/mobile-preview_appstack.php)
    #           https://js.stripe.com for Stripe Payment Element
    # - connect: self + APIs used (Google Maps, Open-Meteo weather, Stripe, Esri tiles for offline cache)
    #
    # Fable #22 (2026-10-12): the PUBLIC site (head.php pages, CMS pages, /services/*) and the
    # CUSTOMER portal (/customer/*) send a stricter per-request nonce CSP from PHP
    # (app/Core/Csp.php — no 'unsafe-inline'/'unsafe-eval' for scripts). MW_NONCE_CSP marks those
    # URLs so this lax policy is not added on top. If a server ignores env= the browser enforces
    # both headers, which is still the strict one (its hosts are a subset of these).
    # The CRM (AppStack), site-admin, jobFlow etc. keep this policy for now — follow-up.
    <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/$" MW_NONCE_CSP=1
    SetEnvIf Request_URI "^/customer/" MW_NONCE_CSP=1
    SetEnvIf Request_URI "^/(index|about|contact|portfolio|privacy|privacy-request|blog|before-after|services_static|cms-render)(\.php)?/?$" MW_NONCE_CSP=1
    SetEnvIf Request_URI "^/services(/[a-z0-9-]+(\.php)?)?/?$" MW_NONCE_CSP=1
    SetEnvIf Request_URI "^/[a-z0-9-]+(/[a-z0-9-]+)*/?$" MW_NONCE_CSP=1
    SetEnvIf Request_URI "^/(crm|site-admin|cms|api|client|bluemoon|downloads|uploads|assets|storage|_media|quote|forgot-password|reset-password|unsubscribe|optin-confirm|sitemap)(/|\.php|$)" !MW_NONCE_CSP
    </IfModule>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://www.gstatic.com https://www.google.com https://www.recaptcha.net https://js.stripe.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://maps.googleapis.com https://maps.gstatic.com https://*.google.com https://*.tile.openstreetmap.org https://a.tile.openstreetmap.org https://b.tile.openstreetmap.org https://c.tile.openstreetmap.org https://server.arcgisonline.com; connect-src 'self' https://maps.googleapis.com https://api.open-meteo.com https://api.weather.gc.ca https://api.stripe.com https://server.arcgisonline.com; frame-src 'self' https://www.google.com https://www.recaptcha.net https://js.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self';" env=!MW_NONCE_CSP

    # Remove server version info
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# Default documents (public site)
DirectoryIndex index.php index.html

# PWA manifest MIME type (required for Chrome install prompt)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    # Android App Links / generic JSON (e.g. /.well-known/assetlinks.json)
    AddType application/json .json
</IfModule>

# Android App Links — make sure /.well-known/assetlinks.json is reachable
# (real file, so the CMS catch-all already skips it) and served as JSON.
<Files "assetlinks.json">
    <IfModule mod_headers.c>
        Header set Content-Type "application/json"
    </IfModule>
    Require all granted
</Files>

# Protect sensitive files
<FilesMatch "^(config\.php|auth\.php|session_config\.php|secrets\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Internal docs, logs, dumps and editor/OS files — never web-readable (2026-10-12: CLAUDE.md,
# .git-ftp.log, .DS_Store and *_ARCHITECTURE.md were all public). .well-known and llms.txt unaffected.
<FilesMatch "(\.(md|log|sql|bak|orig|swp)|\.DS_Store|\.gitignore|\.git-ftp\.log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Data exports, archives and build/runtime config — never served as static files (security audit
# 2026-10-12 #1/#7: Jobber client CSVs sat downloadable in crm/tmp; composer.lock, php.ini and
# .user.ini were readable). Downloads the CRM offers are generated by PHP and are unaffected.
# No page links a static .csv/.xlsx/.zip under public/ (checked 2026-10-12), so nothing is exempt.
# tests/Unit/Security/WebRootHygieneTest.php keeps this rule and fails on such files outside uploads/.
<FilesMatch "(\.(csv|xlsx|xls|zip|gz|tgz|tar|bak)|^composer\.(json|lock)|^php\.ini|^\.user\.ini)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── URL Rewrites ──
RewriteEngine On

# ── Canonical URLs (SEO) ─────────────────────────────────────────────────────
# One URL per page. Google had indexed http://, www., .php and /home variants
# of every page as separate documents; every rule here is a 301 so those
# duplicates consolidate onto the clean https://mowology.ca/<slug> form.

# Scheme + host. Only on the production host so dev hostnames are untouched.
RewriteCond %{HTTP_HOST} ^(www\.)?mowology\.ca$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://mowology.ca%{REQUEST_URI} [L,R=301]

# Legacy .php and alias URLs → clean URLs. THE_REQUEST is the browser's
# original request line, so these never fire on the internal rewrites below
# (e.g. /privacy → /privacy.php) and cannot loop.
RewriteCond %{THE_REQUEST} \s/+(index\.php|home)/?[\s?] [NC]
RewriteRule ^ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+(about|contact|portfolio|privacy|privacy-request)\.php[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{THE_REQUEST} \s/+services/([a-z0-9-]+)\.php[\s?] [NC]
RewriteRule ^ /services/%1 [L,R=301]
# Trailing slash → none on public pages (services/ is a real directory; see
# services/.htaccess for why /services no longer bounces to /services/).
RewriteCond %{THE_REQUEST} \s/+(about|contact|portfolio|privacy|privacy-request|quote|services|services/[a-z0-9-]+)/[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# sitemap.xml is generated by sitemap.php (the stale static file was removed)
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# mowology.ca/crew → the crew app download (easy to type on a tablet). Point it at the release APK
# (/crm/downloads/mowology-crew.apk) once 1.7.0 is released to everyone.
RewriteRule ^crew/?$ /crm/downloads/mowology-crew-1.7.1-test.apk [NC,L,R=302]

# /quote → /quote.php (pass query string through)
RewriteRule ^quote/?$ /quote.php [L,QSA]

# /before-after → clean URL for public gallery page
RewriteRule ^before-after/?$ /before-after.php [L,QSA]

# /forgot-password and /reset-password — iOS app password reset flow
RewriteRule ^forgot-password/?$ /forgot-password.php [L,QSA]
RewriteRule ^reset-password/?$ /reset-password.php [L,QSA]

# /services → CMS (services/ directory exists, so catch-all skips it)
RewriteRule ^services/?$ /cms-render.php?page=services [L,QSA]

# /services/slug → /services/slug.php (clean URLs for static service landing pages)
# Only applies when the .php file exists; otherwise falls through to CMS catch-all
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/services/$1.php -f
RewriteRule ^services/([a-z0-9\-]+)/?$ /services/$1.php [L,QSA]

# /privacy and /privacy-request — PIPEDA public pages
RewriteRule ^privacy/?$ /privacy.php [L,QSA]
RewriteRule ^privacy-request/?$ /privacy-request.php [L,QSA]

# /api/module/action → handled by /api/.htaccess (do not rewrite here)
RewriteRule ^api/ - [L]

# ── BlueMoon PWA sub-app ──────────────────────────────────────────────────────
# 1. Pass all real files/dirs inside /bluemoon/ through untouched
RewriteRule ^bluemoon/ - [L]

# ── Service Worker — must NEVER be cached (SW spec requirement) ──────────────
# LiteSpeed adds its own Cache-Control: max-age=31536000 for PHP files,
# which overrides the PHP header() call and stops the SW from ever updating.
# "Header always set" replaces any previously set Cache-Control (incl. LiteSpeed).
<Files "service-worker.php">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set X-LiteSpeed-Cache-Control "no-store, no-cache"
</Files>

# ── Static asset caching (Core Web Vitals) ──────────────────────────────────
<IfModule mod_headers.c>
    # Images and fonts never change in place (new content gets a new filename).
    <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # CSS/JS: the public site cache-busts with ?v=mtime but the CRM does not
    # everywhere, so one day rather than one year.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    # HSTS — safe now that every http:// request is 301'd to https:// above.
    Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# Security: allow JS workers to be fetched with correct MIME and COOP headers
<FilesMatch "\.worker\.js$">
    Header set Content-Type "application/javascript"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "require-corp"
</FilesMatch>

# ── CMS Catch-All ──
# Routes unmatched slugs to CMS front controller.
# Backwards-compatible: existing files still load directly.
# cms-render.php falls back to legacy pages if no CMS page found.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9\-\/]+)/?$ /cms-render.php?page=$1 [L,QSA]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
