# Disable directory browsing
Options -Indexes

# Default documents (public site)
DirectoryIndex index.php index.html

# PWA manifest MIME type (required for Chrome install prompt)
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Protect sensitive files
<FilesMatch "^(config\.php|auth\.php|session_config\.php|secrets\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── URL Rewrites ──
RewriteEngine On

# Force HTTPS (uncomment on production)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /quote → /quote.php (pass query string through)
RewriteRule ^quote/?$ /quote.php [L,QSA]

# /services → CMS (services/ directory exists, so catch-all skips it)
RewriteRule ^services/?$ /cms-render.php?page=services [L,QSA]

# /services/slug → /services/slug.php (clean URLs for static service landing pages)
# Only applies when the .php file exists; otherwise falls through to CMS catch-all
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/services/$1.php -f
RewriteRule ^services/([a-z0-9\-]+)/?$ /services/$1.php [L,QSA]

# /api/module/action → handled by /api/.htaccess (do not rewrite here)
RewriteRule ^api/ - [L]

# ── BlueMoon PWA sub-app ──────────────────────────────────────────────────────
# 1. Pass all real files/dirs inside /bluemoon/ through untouched
RewriteRule ^bluemoon/ - [L]

# Security: allow JS workers to be fetched with correct MIME and COOP headers
<FilesMatch "\.worker\.js$">
    Header set Content-Type "application/javascript"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "require-corp"
</FilesMatch>

# ── CMS Catch-All ──
# Routes unmatched slugs to CMS front controller.
# Backwards-compatible: existing files still load directly.
# cms-render.php falls back to legacy pages if no CMS page found.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9\-\/]+)/?$ /cms-render.php?page=$1 [L,QSA]
