default_platform(:ios)

PROJECT    = "../ios/MowologyCRM/MowologyCRM.xcodeproj"
SCHEME     = "MowologyCRM"
ARCHIVE    = "/tmp/MowologyCRM.xcarchive"
EXPORT_DIR = "/tmp/MowologyCRM-export"

platform :ios do
  desc "Build and upload Mowology CRM to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false
    )

    build     = ENV["GITHUB_RUN_NUMBER"] || "1"
    team      = ENV.fetch("APPLE_TEAM_ID")
    key_id    = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    key_path  = "/tmp/asc_key.p8"

    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8")))

    auth = "-allowProvisioningUpdates " \
           "-authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{issuer_id}"

    # Download/reuse the App Store distribution cert + profile via API key.
    # This avoids CI creating development certificates (which have a 2-cert limit).
    cert(api_key: api_key, development: false, output_path: "/tmp")
    profile = sigh(
      api_key: api_key,
      app_identifier: "ca.mowology.crm-field",
      provisioning_name: "MowologyCRM AppStore",
      ignore_profiles_with_different_name: true,
      output_path: "/tmp"
    )

    # Archive using manual signing with the distribution cert + profile
    sh "xcodebuild " \
       "-project #{PROJECT} " \
       "-scheme #{SCHEME} " \
       "-configuration Release " \
       "-destination 'generic/platform=iOS' " \
       "-archivePath #{ARCHIVE} " \
       "#{auth} " \
       "DEVELOPMENT_TEAM=#{team} " \
       "CODE_SIGN_STYLE=Manual " \
       "CODE_SIGN_IDENTITY='Apple Distribution' " \
       "PROVISIONING_PROFILE_SPECIFIER='MowologyCRM AppStore' " \
       "CURRENT_PROJECT_VERSION=#{build} " \
       "clean archive"

    # Export
    sh "xcodebuild " \
       "-exportArchive " \
       "-archivePath #{ARCHIVE} " \
       "-exportOptionsPlist ../ios/ExportOptions.plist " \
       "-exportPath #{EXPORT_DIR} " \
       "#{auth}"

    ipa_path = Dir.glob("#{EXPORT_DIR}/*.ipa").first
    UI.user_error!("No IPA found in #{EXPORT_DIR}") unless ipa_path
    UI.message("Uploading #{ipa_path}")

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
