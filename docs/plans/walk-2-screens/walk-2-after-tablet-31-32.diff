@@ -0,0 +1,35 @@
+package ca.mowology.crew.auth
+
+import java.util.Random
+import org.junit.Assert.*
+import org.junit.Test
+
+class PasswordGenTest {
+    @Test fun generatedPasswordHasFourGroupsOfFour() {
+        assertTrue(PasswordGen.generate(Random(1)).matches(
+            Regex("^(?!.*[0Oo1lI])[A-Za-z2-9]{4}(?:-[A-Za-z2-9]{4}){3}$")))
+    }
+
+    @Test fun generatedPasswordsNeverContainLookAlikes() {
+        val random = Random(2)
+        repeat(2_000) { assertFalse(PasswordGen.generate(random).any { it in "0Oo1lI" }) }
+    }
+
+    @Test fun everyGeneratedPasswordContainsEveryCharacterClass() {
+        val random = Random(3)
+        repeat(2_000) {
+            val password = PasswordGen.generate(random)
+            assertTrue(password.any(Char::isUpperCase))
+            assertTrue(password.any(Char::isLowerCase))
+            assertTrue(password.any(Char::isDigit))
+        }
+    }
+
+    @Test fun differentSeedsProduceDifferentPasswords() {
+        assertNotEquals(PasswordGen.generate(Random(4)), PasswordGen.generate(Random(5)))
+    }
+
+    @Test fun generatedPasswordExceedsServerMinimumLength() {
+        assertTrue(PasswordGen.generate(Random(6)).length >= 10)
+    }
+}
