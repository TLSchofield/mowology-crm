+++ b/android/app/src/main/java/ca/mowology/crew/auth/PasswordGen.kt
@@ -0,0 +1,20 @@
+package ca.mowology.crew.auth
+
+import java.security.SecureRandom
+import java.util.Random
+
+object PasswordGen {
+    private const val UPPER = "ABCDEFGHJKLMNPQRSTUVWXYZ"
+    private const val LOWER = "abcdefghijkmnpqrstuvwxyz"
+    private const val DIGITS = "23456789"
+    private const val ALPHABET = UPPER + LOWER + DIGITS
+
+    fun generate(random: Random = SecureRandom()): String {
+        while (true) {
+            val raw = CharArray(16) { ALPHABET[random.nextInt(ALPHABET.length)] }
+            if (raw.any(UPPER::contains) && raw.any(LOWER::contains) && raw.any(DIGITS::contains)) {
+                return raw.concatToString().chunked(4).joinToString("-")
+            }
+        }
+    }
+}
diff --git a/android/app/src/main/java/ca/mowology/crew/auth/SavedLogin.kt b/android/app/src/main/java/ca/mowology/crew/auth/SavedLogin.kt
new file mode 100644
index 0000000..13e1772
--- /dev/null
+++ b/android/app/src/main/java/ca/mowology/crew/auth/SavedLogin.kt
@@ -0,0 +1,65 @@
+package ca.mowology.crew.auth
+
+import android.app.Activity
+import android.content.Context
+import android.content.ContextWrapper
+import android.util.Log
+import androidx.credentials.CreatePasswordRequest
+import androidx.credentials.CredentialManager
+import androidx.credentials.GetCredentialRequest
+import androidx.credentials.GetPasswordOption
+import androidx.credentials.PasswordCredential
+import androidx.credentials.exceptions.CreateCredentialException
+import androidx.credentials.exceptions.GetCredentialCancellationException
+import androidx.credentials.exceptions.GetCredentialException
+import androidx.credentials.exceptions.NoCredentialException
+
+object SavedLoginLogic {
+    fun shouldOfferSave(isIttai: Boolean, email: String, password: String): Boolean =
+        isIttai && email.isNotBlank() && password.isNotBlank()
+
+    fun shouldPick(isIttai: Boolean, alreadyPickedThisLaunch: Boolean, fieldsEmpty: Boolean): Boolean =
+        isIttai && !alreadyPickedThisLaunch && fieldsEmpty
+}
+
+object SavedLogin {
+    private const val TAG = "SavedLogin"
+
+    suspend fun offerSave(activity: Activity, email: String, password: String) {
+        try {
+            CredentialManager.create(activity).createCredential(activity, CreatePasswordRequest(email, password))
+        } catch (e: CreateCredentialException) {
+            Log.i(TAG, "Password save was not completed: ${e.javaClass.simpleName}")
+        } catch (e: Exception) {
+            Log.i(TAG, "Password save was not completed: ${e.javaClass.simpleName}")
+        }
+    }
+
+    suspend fun pick(activity: Activity): Pair<String, String>? = try {
+        val request = GetCredentialRequest(
+            listOf(GetPasswordOption()),
+            preferImmediatelyAvailableCredentials = true
+        )
+        val credential = CredentialManager.create(activity).getCredential(activity, request).credential
+        (credential as? PasswordCredential)?.let { it.id to it.password }
+    } catch (e: NoCredentialException) {
+        null
+    } catch (e: GetCredentialCancellationException) {
+        null
+    } catch (e: GetCredentialException) {
+        null
+    } catch (e: Exception) {
+        null
+    }
+}
+
+fun Context.findActivity(): Activity? {
+    var current = this
+    while (current is ContextWrapper) {
+        if (current is Activity) return current
+        val next = current.baseContext
+        if (next === current) break
+        current = next
+    }
+    return current as? Activity
+}
