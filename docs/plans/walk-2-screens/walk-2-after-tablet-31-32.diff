@@ -0,0 +1,11 @@
+package ca.mowology.crew.auth
+
+/** Pure: which email (if any) to carry from one auth form to the other. */
+object AuthHandoff {
+    /** Returns the email to copy into the target field, or null to leave the target alone. */
+    fun carry(from: String, target: String): String? {
+        val email = from.trim()
+        if (target.isNotBlank() || !SignUpLogic.emailValid(email)) return null
+        return email
+    }
+}
diff --git a/android/app/src/main/java/ca/mowology/crew/auth/PasswordGen.kt b/android/app/src/main/java/ca/mowology/crew/auth/PasswordGen.kt
