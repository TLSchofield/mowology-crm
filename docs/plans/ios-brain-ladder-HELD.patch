+            let t = V(0, 1, 0), b1 = V(0.9428, -0.3333, 0), b2 = V(-0.4714, -0.3333, 0.8165), b3 = V(-0.4714, -0.3333, -0.8165)
+            let a = V(0, 0.45, 0), p0 = V(0.95, -0.55, 0), p1 = V(-0.475, -0.55, 0.8227), p2 = V(-0.475, -0.55, -0.8227)
+            if k == 2 {
+                tris = [[V(0, 0.85, -0.31), V(0, -0.85, -0.31), V(1.02, 0, 0.15)], [V(0, 0.85, -0.31), V(0, -0.85, -0.31), V(-1.02, 0, 0.15)]]
+            } else if k == 3 {
+                tris = [[a, p0, p1], [a, p1, p2], [a, p2, p0]]
+            } else {
+                tris = [[t, b1, b2], [t, b2, b3], [t, b3, b1], [b1, b3, b2]]
+            }
         } else if k <= 90 && k % 3 != 0 {
             if k % 3 == 1 { tris = Self.bipyramid(max(3, Int((Double(need) / 2).rounded(.up)))) }
             else { tris = Self.gyrobipyramid(max(3, Int((Double(need) / 4).rounded(.up)))) }
