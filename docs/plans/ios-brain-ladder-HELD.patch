 import SwiftUI
 import simd
+import JavaScriptCore
+
+// MARK: - The ladder, from the web (owner, 2026-10-20)
+
+/// Since 2026-10-20 the brain's 500 shapes are the web's: shape N has exactly N triangles (one triangle,
+/// the open book, Sierpinski triangles, the eight equilateral solids, snowflakes, geodesic spheres…), built by
+/// public/crm/js/head-brain.js. Rather than a second copy in Swift, the app runs that same file in
+/// JavaScriptCore: downloaded from the site, kept in Caches, refreshed in the background. Until the first
+/// download (or if the file ever fails its checks) BrainShape falls back to the Swift shapes below.
+/// The file only does arithmetic here: the context gets no bridges, network or storage.
+final class BrainLadder {
+    static let shared = BrainLadder()
+    typealias Built = (tris: [[SIMD3<Double>]], flat: Bool)
+
+    private let source = URL(string: "https://mowology.ca/crm/js/head-brain.js")!
+    private let lock = NSLock()
+    private var shapeFn: JSValue?
+    private var context: JSContext?
+    private var built: [Int: Built] = [:]
+    private var refreshing = false
+
+    private var file: URL {
+        FileManager.default.urls(for: .cachesDirectory, in: .userDomainMask)[0].appendingPathComponent("head-brain.js")
+    }
+
+    private init() {
+        if let js = try? String(contentsOf: file, encoding: .utf8) { _ = install(js) }
+        refresh()
+    }
+
+    /// Load the cached file off the main thread at app start, so the first brain drawn doesn't wait for it.
+    static func warmUp() { DispatchQueue.global(qos: .userInitiated).async { _ = BrainLadder.shared } }
+
+    /// Shape k from the web's ladder, or nil (not downloaded yet / not valid) → the caller uses its own.
+    func shape(_ k: Int) -> Built? {
+        lock.lock(); defer { lock.unlock() }
+        if let b = built[k] { return b }
+        guard let fn = shapeFn, let s = fn.call(withArguments: [k]),
+              let raw = s.forProperty("tris")?.toArray() as? [[[Double]]], raw.count == k,
+              // Every triangle three points, every point three real numbers — a bad file falls back, never crashes.
+              raw.allSatisfy({ $0.count == 3 && $0.allSatisfy { $0.count == 3 && $0.allSatisfy(\.isFinite) } }) else { return nil }
+        let tris = raw.map { $0.map { SIMD3<Double>($0[0], $0[1], $0[2]) } }
+        let b: Built = (tris, s.forProperty("flat")?.toBool() ?? false)
+        built[k] = b
+        return b
+    }
+
+    /// Fetch the current file; keep it only if it builds the first shapes exactly (each shape is checked again when used).
+    func refresh() {
+        lock.lock()
+        if refreshing { lock.unlock(); return }
+        refreshing = true
+        lock.unlock()
+        var req = URLRequest(url: source, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 20)
+        req.setValue("no-cache", forHTTPHeaderField: "Cache-Control")
+        URLSession.shared.dataTask(with: req) { [weak self] data, response, _ in
+            guard let self else { return }
+            defer { self.lock.lock(); self.refreshing = false; self.lock.unlock() }
+            guard (response as? HTTPURLResponse)?.statusCode == 200, let data,
+                  let js = String(data: data, encoding: .utf8), js.contains("var RECIPES") else { return }
+            if self.install(js) { try? data.write(to: self.file, options: .atomic) }
+        }.resume()
+    }
+
+    @discardableResult
+    private func install(_ js: String) -> Bool {
+        guard let ctx = JSContext() else { return false }
+        // The page globals head-brain.js touches on load; no DOM, so it never draws or mounts anything.
+        ctx.evaluateScript("var window = this; window.matchMedia = function () { return { matches: false }; }; var document = { readyState: 'loading', addEventListener: function () {}, querySelectorAll: function () { return []; } };")
+        ctx.evaluateScript(js)
+        guard ctx.exception == nil, let fn = ctx.evaluateScript("window.HeadBrain && window.HeadBrain.shape"), fn.isObject else { return false }
+        // Small shapes only: this runs on first use, which can be a view on the main thread.
+        for k in [1, 2, 4] {
+            guard let n = fn.call(withArguments: [k])?.forProperty("tris")?.forProperty("length")?.toInt32(), n == k else { return false }
+        }
+        lock.lock()
+        context = ctx; shapeFn = fn; built = [:]
+        lock.unlock()
+        return true
+    }
+}
 
