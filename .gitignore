# Sensitive files & secrets
crm/config.php
public/app_config/secrets.php
.env
*.log

# Local development tools (NEVER commit to repo)
public/loginAuth/local-bypass.php
public/DEBUG_UTILITY.php
public/POPULATE_TEST_DATA.php
LOCAL_DEV_SETUP.md

# Database backups
*.sql
!database/migrations/*.sql
!public/database/migrations/*.sql
crm/backup/

# Composer vendor directory — committed to repo for cPanel hosting (no CLI access)
# /public/vendor/

# Generated PDFs (keep directory structure via .gitkeep)
/storage/pdfs/quotes/*.pdf
/storage/pdfs/invoices/*.pdf

# Weather & geocoding cache (transient data)
/storage/weather/
/storage/geocode/

# Tracking module — cached OAuth token + last-position file (transient)
/app/Storage/cache/trackimo_token.json
/app/Storage/cache/trackimo_last_position.json
/app/Storage/logs/trackimo.log

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Temp files
crm/logs/
tmp/
cache/

# Claude dev tools
.claude/context.token

# Google Cloud service-account keys (CREDENTIALS — never commit; rotate if exposed)
public/app_config/*.json

# PHPUnit result cache
.phpunit.result.cache
