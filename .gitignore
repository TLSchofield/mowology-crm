# Sensitive files & secrets
crm/config.php
public/app_config/secrets.php
.env
*.log

# Local development tools (NEVER commit to repo)
public/loginAuth/local-bypass.php
public/DEBUG_UTILITY.php
public/POPULATE_TEST_DATA.php
LOCAL_DEV_SETUP.md

# Database backups
*.sql
!database/migrations/*.sql
crm/backup/

